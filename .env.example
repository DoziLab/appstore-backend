# Application
APP_NAME=Teaching App Store Backend
APP_VERSION=0.1.0
DEBUG=false

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dozilab

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Keycloak Authentication
# Base URL of your Keycloak server
KEYCLOAK_URL=http://localhost:8080
# Keycloak realm name
KEYCLOAK_REALM=appstore

# Client ID (must match frontend client in Keycloak)
KEYCLOAK_CLIENT_ID=appstore-backend

# JWKS cache TTL in seconds (default: 3600 = 1 hour)
KEYCLOAK_JWKS_CACHE_TTL=3600

# JWT Validation (Keycloak uses RS256)
JWT_ALGORITHM=RS256

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_secure_password