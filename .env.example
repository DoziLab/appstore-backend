# Application
APP_NAME=Teaching App Store Backend
APP_VERSION=0.1.0
DEBUG=false

# Database
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dozilab

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Keycloak Authentication
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=appstore
KEYCLOAK_CLIENT_ID=appstore-backend
KEYCLOAK_JWKS_CACHE_TTL=3600

# JWT Validation (Keycloak uses RS256)
JWT_ALGORITHM=RS256

# Encryption (generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=your-generated-fernet-key-here

# ------------------------------------------------------------------------------
# Ansible SSH Key (one-time server setup required)
#
# 1. Generate the key once on the server:
#      ssh-keygen -t ed25519 -f ~/.ssh/dozilab_ansible -C "dozilab-ansible" -N ""
#      chmod 600 ~/.ssh/dozilab_ansible
#
# 2. Set the path here:
#      Local:      ANSIBLE_SSH_KEY_PATH=~/.ssh/dozilab_ansible
#      Production: ANSIBLE_SSH_KEY_PATH=/run/secrets/dozilab_ansible
#
# 3. Registering the public key in OpenStack is NOT required manually —
#    it happens automatically when a lecturer registers their OpenStack project
#    in the AppStore (via AnsibleKeypairService.ensure_keypair).
#
# ANSIBLE_SSH_KEY_NAME must match the keypair name in OpenStack.
# ------------------------------------------------------------------------------
ANSIBLE_SSH_KEY_PATH=/run/secrets/dozilab_ansible
ANSIBLE_SSH_KEY_NAME=dozilab-ansible-key

# ------------------------------------------------------------------------------
# GitHub App (only needed if you want to import templates from GitHub repos)
#
# 1. Create a GitHub App: https://github.com/settings/apps/new
#    - Callback URL: https://<your-host>/api/v1/auth/github/install-callback
#    - Webhook: deactivate (not used)
#    - Repository permissions: Contents = Read-only, Metadata = Read-only
#    - Where can it be installed: "Any account" if external lecturers should
#      connect their own repos, otherwise "Only on this account"
#
# 2. From the App's settings page collect:
#      GITHUB_APP_ID         — numeric "App ID"
#      GITHUB_APP_SLUG       — URL slug after /apps/ (used for the install link)
#      GITHUB_APP_PRIVATE_KEY — full PEM contents of the generated private key
#                              (multi-line; quote the value in .env files)
#
# 3. Generate a state secret (HMAC for the install-callback round-trip):
#      python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 4. FRONTEND_BASE_URL is where the install-callback redirects the user back
#    to after GitHub finishes the install (must match a route in the SPA).
#
# Leave blank if the feature is disabled — the API endpoints will return a
# clear "GitHub App is not configured" error when called.
# ------------------------------------------------------------------------------
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_STATE_SECRET=
FRONTEND_BASE_URL=http://localhost:5173

# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=changeme_secure_password
