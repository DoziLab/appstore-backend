meta {
  name: Create Template
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/templates
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "name": "Python Flask Template",
    "description": "A template for Flask web applications",
    "repo_url": "https://github.com/example/flask-template",
    "icon_url": "mdi:flask"
  }
}

script:post-response {
  if (res.status === 201 && res.body && res.body.data && res.body.data.id) {
    bru.setEnvVar("template_id", res.body.data.id);
    console.log("Saved template_id =", res.body.data.id);
  }
}

docs {
  # Create Template

  Creates a new template. Templates are always created with `visibility=private`.
  Approval gating now lives on each TemplateVersion (see /template-versions
  endpoints) — there is no per-template `approval_status` anymore.

  ## Required Role

  ADMIN or LECTURER.

  ## Body

  - `name` (required, ≤ 255)
  - `description` (optional)
  - `repo_url` (required, ≤ 500)
  - `icon_url` (optional, ≤ 500) — e.g. `mdi:flask`, `🚀`, `/icons/template.svg`
  - `visibility` (ignored on create; backend pins to `private`)

  ## Returns

  Created Template with `visibility='private'`. The post-response script saves
  `template_id` for follow-up requests.
}
