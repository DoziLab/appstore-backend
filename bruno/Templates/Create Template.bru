meta {
  name: Create Template
  type: http
  seq: 3
}

post {
  url: {{base_url}}/api/v1/templates
  body: json
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

body:json {
  {
    "name": "Python Flask Template",
    "description": "A template for Flask web applications",
    "repo_url": "https://github.com/example/flask-template"
  }
}

docs {
  # Create Template
  
  Creates a new template with visibility 'private' and approval status 'pending'.
  Templates must be approved by an admin before becoming publicly available.
  
  **Note:** Templates are ALWAYS created as private, regardless of input.
  Use the approve endpoint to make them public.
  
  **Required Role:** ADMIN or LECTURER
  
  **Request Body:**
  - `name`: Template name (required, max 255 chars)
  - `description`: Template description (optional)
  - `repo_url`: Git repository URL (required, max 500 chars)
  
  **Returns:** Created template with visibility='private' and approval_status='pending'
}
