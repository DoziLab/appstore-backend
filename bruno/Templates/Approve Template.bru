meta {
  name: Approve Template
  type: http
  seq: 6
}

post {
  url: {{base_url}}/api/v1/templates/{{template_id}}/approve
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  # Approve Template
  
  Approves a template for public use. Only admins can approve templates.
  
  **What happens on approval:**
  1. Sets `approval_status` to 'approved'
  2. Automatically sets `visibility` to 'public'
  3. Template becomes available to all users
  
  **Required Role:** ADMIN
  
  **Path Parameters:**
  - `template_id`: UUID of the template
  
  **Returns:** Updated template with approval_status='approved' and visibility='public'
}
