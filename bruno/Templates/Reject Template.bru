meta {
  name: Reject Template
  type: http
  seq: 7
}

post {
  url: {{base_url}}/api/v1/templates/{{template_id}}/reject
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  # Reject Template
  
  Rejects a template. Only admins can reject templates.
  Rejected templates remain visible to owners but are not publicly available.
  
  **Required Role:** ADMIN
  
  **Path Parameters:**
  - `template_id`: UUID of the template
  
  **Returns:** Updated template with approval_status='rejected'
}
