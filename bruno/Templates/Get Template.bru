meta {
  name: Get Template
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/templates/{{template_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  # Get Template
  
  Retrieves details of a specific template by its ID.
  
  **Visibility Rules:**
  - Admins can see all templates
  - Lecturers can see:
    - Their own templates (any status/visibility)
    - Approved public templates from others
  
  **Required Role:** ADMIN or LECTURER
  
  **Path Parameters:**
  - `template_id`: UUID of the template
  
  **Returns:** Complete template details including metadata and timestamps
}
