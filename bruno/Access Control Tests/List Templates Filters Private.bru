meta {
  name: List Templates Filters Private
  type: http
  seq: 5
}

get {
  url: {{base_url}}/api/v1/templates
  body: none
  auth: bearer
}

auth:bearer {
  token: {{other_access_token}}
}

docs {
  # List Templates Filters Private

  Test that list templates endpoint filters out private templates from other users.

  **Expected:** 200 OK with filtered list (no private templates from other users)

  **Setup:**
  - Use non-owner user credentials
  - Multiple templates exist with different owners/visibility

  **Verifies:**
  - List endpoint respects access control
  - Users only see:
    1. Their own templates (any visibility)
    2. Public approved templates from others
}

assert {
  res.status: eq 200
}

script:post-response {
  const data = res.getBody().data;
  
  // Check that no private templates from other users are returned
  const hasOthersPrivate = data.some(template => 
    template.visibility === 'private' && template.owner_id !== bru.getEnvVar('other_user_id')
  );
  
  if (hasOthersPrivate) {
    throw new Error('Found private templates from other users in list');
  }
}
