meta {
  name: Admin View Any Template (200)
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/templates/{{private_template_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{admin_access_token}}
}

docs {
  # Admin View Any Template

  Test that admin users can view any template regardless of ownership or visibility.

  **Expected:** 200 OK with template data

  **Setup:**
  - Use admin user credentials
  - Template can be owned by any user
  - Template can have any visibility

  **Verifies:**
  - Admins bypass ownership restrictions
  - Admins have full system visibility
}

assert {
  res.status: eq 200
}
