meta {
  name: Owner View Private Template (200)
  type: http
  seq: 1
}

get {
  url: {{base_url}}/api/v1/templates/{{private_template_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{owner_access_token}}
}

docs {
  # Owner View Private Template

  Test that template owner can view their own private template.

  **Expected:** 200 OK with template data

  **Setup:**
  - Use owner user credentials
  - Template must be owned by this user
  - Template visibility = private

  **Verifies:**
  - Owner has full access to their private templates
}
