vars:pre-request {
  template_version_id: 74007335-ed37-42c4-bb6f-3160f7b98ef8
}

script:post-response {
  if (res.status === 201) {
    const data = res.body.data;
    bru.setEnvVar("deployment_id", data.id);
    console.log("✅ Deployment created! ID:", data.id);
    console.log("Status:", data.status);
    console.log("Course ID (Keycloak):", data.course_id);
  } else {
    console.log("❌ Deployment creation failed:", res.status, res.body);
  }
}

docs {
  # Create Deployment (One-Click Deployment)
  
  Creates a new deployment and queues it for asynchronous processing via Celery.
  
  **Required Role:** Admin or Lecturer
  
  **Request Body:**
  - `name`: Deployment name for identification
  - `template_version_id`: ID of the template version to deploy
  - `course_id`: Keycloak group ID for the course
  - `heat_parameters`: Heat template parameters as dict (image, flavor, network, etc.)
  - `stack_assignments`: Array of stack assignments with groups and students
  - `teacher`: Teacher/lecturer information from Keycloak
  
  **Stack Assignments Structure:**
  Each stack assignment contains:
  - `stack_index`: Optional stack number (for multi-stack deployments)
  - `groups`: Array of groups with:
    - `group_name`: Group display name
    - `group_index`: Group number
    - `students`: Array of student objects with id, username, email, first_name, last_name
  
  **Teacher Structure:**
  - `id`: Keycloak user UUID
  - `username`: Teacher username
  - `email`: Teacher email
  - `first_name`: Teacher first name
  - `last_name`: Teacher last name
  
  **Heat Parameters:**
  Use the `/template-versions/{version_id}/parameters` endpoint to get the list of
  required and optional parameters for the template. The backend automatically generates
  `user_json` and `admin_credentials` from stack_assignments and teacher data.
  
  **Example Heat Parameters (PostgreSQL Group DB):**
  ```json
  {
    "image": "Ubuntu 22.04 2025-01",
    "flavor": "gp1.small",
    "network": "NAT",
    "external_network": "DHBW",
    "ssh_cidr": "141.72.0.0/16",
    "web_cidr": "141.72.0.0/16"
  }
    "db_password": "securepassword123",
    "postgres_version": 14
  }
  ```
  
  **Returns:** Created deployment with status QUEUED
  
  **Note:** The deployment is processed asynchronously. Use the logs endpoint to track progress.
}
