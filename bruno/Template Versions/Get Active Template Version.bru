meta {
  name: Get Active Template Version
  type: http
  seq: 5
}

get {
  url: {{base_url}}/api/v1/template-versions/template/{{template_id}}/active?include_parameters=true
  body: none
  auth: bearer
}

params:query {
  include_parameters: true
}

auth:bearer {
  token: {{access_token}}
}

docs {
  # Get Active Template Version

  Retrieves the currently active version for a specific template, or `null`
  if no active version exists.

  ## Path Parameters

  - `template_id`: UUID of the template

  ## Query Parameters

  - `include_parameters` (default `true`) — inline `parameters` parsed from
    the active version's `app.yaml`.

  ## Returns

  Active TemplateVersion (with `parameters` when requested) or null.
}
