meta {
  name: Delete Template Version
  type: http
  seq: 11
}

delete {
  url: {{base_url}}/api/v1/template-versions/{{version_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  # Delete Template Version
  
  Deletes a template version permanently. Only template owners or admins can delete.
  Cannot delete the only active version of a template.
  This operation cannot be undone.
  
  **Required Role:** Template owner or admin
  
  **Path Parameters:**
  - `version_id`: UUID of the template version
  
  **Returns:** 204 No Content on success
}
