meta {
  name: Get Template Version
  type: http
  seq: 2
}

get {
  url: {{base_url}}/api/v1/template-versions/{{version_id}}?with_file_count=false
  body: none
  auth: bearer
}

params:query {
  ~with_file_count: false
}

auth:bearer {
  token: {{access_token}}
}

docs {
  # Get Template Version
  
  Retrieves details of a specific template version by its ID.
  Optionally includes the count of files associated with this version.
  
  **Path Parameters:**
  - `version_id`: UUID of the template version
  
  **Query Parameters:**
  - `with_file_count`: Include file count in response (default: false)
  
  **Returns:** Template version details
}
