meta {
  name: Get Template Version
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/template-versions/{{version_id}}?with_file_count=false&include_parameters=true
  body: none
  auth: bearer
}

params:query {
  with_file_count: false
  include_parameters: true
}

auth:bearer {
  token: {{access_token}}
}

docs {
  # Get Template Version

  Retrieves details of a specific template version by its ID.

  ## Path Parameters

  - `version_id`: UUID of the template version

  ## Query Parameters

  - `with_file_count` (default `false`) — include file count in response
  - `include_parameters` (default `true`) — inline `parameters` parsed from the
    version's `app.yaml` (CPU/RAM/disk/etc.). Set to `false` to skip parsing
    when you only need raw fields.

  ## Returns

  Template version details, optionally including `parameters` and/or `file_count`.
}
