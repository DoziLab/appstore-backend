meta {
  name: Get Project Details
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/openstack-projects/{{project_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  # Get Project Details
  
  Retrieves OpenStack project with masked credentials.
  
  **Required Role:** Admin or Lecturer (Owner only)
  
  **Security:**
  - Access is logged for audit trail
  - Credentials are masked in response
  - Only project owner can access
  
  **Variables used:**
  - `project_id`: Set automatically after creating a project
}
