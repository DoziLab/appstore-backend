meta {
  name: Get Project Details
  type: http
  seq: 3
}

get {
  url: {{base_url}}/api/v1/openstack-projects/{{openstack_project_local_id}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

docs {
  # Get Project Details

  Retrieves OpenStack project with masked credentials.

  **Required Role:** Admin or Lecturer (Owner only)

  **Security:**
  - Access is logged for audit trail
  - Credentials are masked in response
  - Only project owner can access

  **Variables used:**
  - `openstack_project_local_id`: Local DB id of the project. Set automatically after creating a project (also used by all Deployment requests as `?openstack_project_id=...`).
}
